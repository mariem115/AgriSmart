<?xml version="1.0" encoding="utf-8"?>
<!-- Nouvelle dépense / nouveau revenu -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            style="@style/AgriSmart.Label"
            android:text="@string/finance_label_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLabel"
            style="@style/Widget.AgriSmart.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/finance_hint_label"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/AgriSmart.Label"
            android:text="@string/finance_label_amount" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAmount"
            style="@style/Widget.AgriSmart.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/AgriSmart.Label"
            android:text="@string/finance_label_category" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            style="@style/Widget.AgriSmart.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/AgriSmart.Label"
            android:text="@string/label_parcel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilParcel"
            style="@style/Widget.AgriSmart.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropParcel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/AgriSmart.Label"
            android:text="@string/label_date" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDate"
            style="@style/Widget.AgriSmart.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_calendar" />
    </LinearLayout>
</ScrollView>
